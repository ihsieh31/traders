# TradingAgents Environment Configuration
# ======================================
# Instructions:
# 1. Copy this file to ".env".
# 2. Replace placeholder values with your own keys.
# 3. Restart the CLI/WebUI after changing this file.
#
# Paper-only build (Phase A.1): live trading is disabled.
# Keep ALPACA_USE_PAPER=True. An explicit False fails closed and no live
# order path exists.


# ---------------------------------------------------------------------------
# Runtime Paths
# ---------------------------------------------------------------------------

# Optional. Defaults to "eval_results".
TRADINGAGENTS_RESULTS_DIR=eval_results

# Optional. Defaults to tradingagents/dataflows/data_cache.
TRADINGAGENTS_CACHE_DIR=tradingagents/dataflows/data_cache

# Optional. Defaults to ~/.tradingagents/memory/trading_memory.md.
TRADINGAGENTS_MEMORY_LOG_PATH=~/.tradingagents/memory/trading_memory.md

# Optional. Override selected bundled model prompt templates with Markdown files.
# Keep grouped paths, for example analysts/market_system.md.
# Missing files fall back to tradingagents/prompts/templates.
TRADINGAGENTS_PROMPT_DIR=


# ---------------------------------------------------------------------------
# LLM Provider Selection
# ---------------------------------------------------------------------------

# Supported values:
# openai, local_openai, google, anthropic, xai, minimax, deepseek, qwen, glm,
# openrouter, ollama, azure
LLM_PROVIDER=openai


# ---------------------------------------------------------------------------
# OpenAI and Local OpenAI-Compatible Endpoints
# ---------------------------------------------------------------------------

# Required for OpenAI models and OpenAI web-search data tools.
# Also used by memory embeddings unless OPENAI_USE_LOCAL points embeddings to
# a compatible local endpoint.
OPENAI_API_KEY=your_openai_api_key_here

# Set true to route core LLM and embedding calls to OPENAI_BASE_URL.
# OpenAI web-search tools still require OPENAI_API_KEY because local endpoints
# usually do not support OpenAI Responses web search.
OPENAI_USE_LOCAL=false

# Examples:
# LM Studio: http://localhost:1234/v1
# Ollama OpenAI compatibility: http://localhost:11434/v1
# vLLM OpenAI server: http://localhost:8000/v1
OPENAI_BASE_URL=http://localhost:1234/v1

# Optional embedding model override for memory.
OPENAI_EMBEDDING_MODEL=text-embedding-ada-002


# ---------------------------------------------------------------------------
# Non-OpenAI LLM Providers
# ---------------------------------------------------------------------------

# Google Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# xAI Grok
XAI_API_KEY=your_xai_api_key_here

# MiniMax (official OpenAI-compatible endpoint: https://api.minimax.io/v1)
MINIMAX_API_KEY=your_minimax_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Alibaba Qwen via DashScope OpenAI-compatible endpoint
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# Zhipu GLM
ZHIPU_API_KEY=your_zhipu_api_key_here

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama does not require an API key by default. Use backend_url in the UI/CLI
# or OPENAI_BASE_URL with LLM_PROVIDER=local_openai for OpenAI compatibility.


# ---------------------------------------------------------------------------
# Azure OpenAI
# ---------------------------------------------------------------------------

AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=your_deployment_name
AZURE_OPENAI_API_VERSION=2024-12-01-preview


# ---------------------------------------------------------------------------
# Trading, Market Data, News, and Macro APIs
# ---------------------------------------------------------------------------

# Alpaca Paper is required for market data and order execution (paper-only).
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
# Paper-only: keep True. False fails closed; there is no live trading path.
ALPACA_USE_PAPER=True

# Finnhub is used for equity news, insider sentiment/transactions, and
# earnings calendar data.
FINNHUB_API_KEY=your_finnhub_api_key_here

# FRED is used by the macro analyst.
FRED_API_KEY=your_fred_api_key_here

# CryptoCompare/CoinDesk-compatible news source used for crypto analysis.
COINDESK_API_KEY=your_cryptocompare_api_key_here

# Optional fallback market data source.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here

# ---------------------------------------------------------------------------
# Phase B: Fixed LLM Roles (Analysis / Decision)
# ---------------------------------------------------------------------------

# Role overrides (analysis_*/decision_*: provider, model, backend URL) are
# CONFIG keys, not environment variables: set them in the WebUI or CLI, which
# persist them alongside the rest of the run configuration. With no role key
# set the quick/deep providers from the UI/CLI apply unchanged. Setting ANY
# role key switches to roles mode: Analysis serves every research node
# (analysts, bull/bear, research manager, trader, risk debators); Decision
# serves only the Risk Manager. Analysis defaults to LLM_PROVIDER / the
# deep-think model; Decision defaults to the resolved Analysis role. A
# cross-provider role without an explicit model fails at startup.

# Role-specific credential overrides ARE environment variables (checked
# before the provider's standard key). Example: DECISION_OPENAI_API_KEY when
# Analysis and Decision both use OpenAI but with different accounts. Secrets
# never enter the UI store.
#ANALYSIS_OPENAI_API_KEY=
#DECISION_OPENAI_API_KEY=

# LLM retry policy: integer 0-3. First try + N retries = at most N+1 requests
# per logical invocation; transient failures (timeout/connection/429/5xx) are
# retried with capped backoff, permanent failures (401/403/invalid) stop
# immediately. Invalid values fail at startup. A provider failure stops the
# whole run and halts auto dispatch until an operator restart.
LLM_MAX_RETRIES=3

# Bounded per-request LLM timeout in seconds. This knob is applied to the
# legacy quick/deep clients. In roles mode (any analysis_*/decision_* key
# set) the Analysis/Decision clients currently use their provider SDK's
# default per-request timeout instead; the retry count and backoff caps
# still bound every request in both modes.
#LLM_REQUEST_TIMEOUT_SECONDS=120

# SEC primary-source access policy requires a contact User-Agent.
SEC_IR_USER_AGENT=your_name_and_contact_here
